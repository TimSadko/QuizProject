<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<GridPane maxHeight="Infinity" maxWidth="Infinity" prefHeight="270" prefWidth="480" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.quiz.quizproject.MainMenuController">
    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="100.0" />
        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="100.0" />
        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="100.0" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints maxHeight="91.0" minHeight="10.0" prefHeight="71.0" vgrow="ALWAYS" />
        <RowConstraints maxHeight="141.6" minHeight="10.0" prefHeight="138.6" vgrow="ALWAYS" />
        <RowConstraints maxHeight="85.0" minHeight="10.0" prefHeight="63.0" vgrow="ALWAYS" />
    </rowConstraints>

    <Label text="Quiz Application" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.halignment="LEFT" GridPane.rowIndex="0" GridPane.valignment="TOP">
        <font>
            <Font name="Arial Bold" size="21.0" />
        </font>
          <GridPane.margin>
             <Insets left="10.0" top="10.0" />
          </GridPane.margin>
    </Label>
   <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
       <Button text="Start New Quiz" onAction="#OnStartNewQuizButtonClick">
           <font>
               <Font name="System Bold" size="15.0" />
           </font>
       </Button>
       <Button text="Exit" onAction="#OnExitButtonClick">
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
       </Button>
   </VBox>
</GridPane>
