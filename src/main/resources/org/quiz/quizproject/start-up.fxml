<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<GridPane maxHeight="Infinity" maxWidth="Infinity" prefHeight="270" prefWidth="480"
          xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="org.quiz.quizproject.StartUpCotroller">
    <rowConstraints>
        <RowConstraints maxHeight="85.0" minHeight="10.0" prefHeight="19.999996185302734" vgrow="ALWAYS"/>
        <RowConstraints maxHeight="234.8" minHeight="10.0" prefHeight="233.8" vgrow="ALWAYS"/>
        <RowConstraints maxHeight="226.00000381469727" minHeight="10.0" prefHeight="19.0" vgrow="ALWAYS"/>
    </rowConstraints>
    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" maxWidth="155.0" minWidth="4.999993801116943" prefWidth="9.999994277954102"/>
        <ColumnConstraints hgrow="ALWAYS" maxWidth="315.00000619888306" minWidth="10.0" prefWidth="131.19999999999996"/>
        <ColumnConstraints hgrow="ALWAYS" maxWidth="346.0" minWidth="10.0" prefWidth="311.0"/>
    </columnConstraints>
    <VBox prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
        <Label fx:id="quizNameLabel">#Quiz_Name#</Label>

        <Label>Enter Your Name:</Label>
        <TextField fx:id="nameTextField"></TextField>

        <Button onAction="#OnStartButtonClick">Start Quiz</Button>
    </VBox>
</GridPane>
